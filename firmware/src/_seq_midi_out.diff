 #include "chord.c"
 
+#ifndef JSM_BACK_TO_NORMAL
+/* JSM ---- MIDI OUT of what the sequencer and the arp play, on the track's channel (trk_midi_ch) ----
+ * The keys already go out in key_on / key_off; MIDI IN is not echoed. These two wrap trk_note_on / trk_note_off for the
+ * arp and the sequencer only (not input_on / input_off: the keys would go out twice). mo_on remembers, per track, which
+ * notes were sent on, so a note-off goes out only for a note-on that did, and seq_midi_panic can end them all.
+ * In the pool as seq_k (further down): a new .bss global would move the others.
+ * Build with -DJSM_BACK_TO_NORMAL to get the original code back. */
+static uint32_t mo_on[NTRK][4] __attribute__((section(".pool")));      // JSM 128 bits per track
+
+static void seq_midi_off(track_t *t, uint32_t note)                    // JSM
+{
+    uint32_t i = trk_index(t);
+    note &= 127u;
+    if (!((mo_on[i][note >> 5] >> (note & 31u)) & 1u))
+        return;
+    mo_on[i][note >> 5] &= ~(1u << (note & 31u));
+    midi_out_event(0x08u | (0x80u | trk_midi_ch(i)) << 8 | note << 16);
+}
+
+static void seq_midi_on(track_t *t, uint32_t note, uint32_t vel)       // JSM
+{
+    uint32_t i = trk_index(t);
+    if (t->p[P_MUTE])                                  /* a muted track sounds nothing: nor does it send */
+        return;
+    note &= 127u;
+    vel = vel ? (vel > 127u ? 127u : vel) : 1u;        /* velocity 0 would be a note-off */
+    seq_midi_off(t, note);                             /* the same note again: ended, then started */
+    mo_on[i][note >> 5] |= 1u << (note & 31u);
+    midi_out_event(0x09u | (0x90u | trk_midi_ch(i)) << 8 | note << 16 | vel << 24);
+}
+
+static void seq_midi_panic(track_t *t)                                 // JSM every note sent on ends (trk_all_off)
+{
+    uint32_t n;
+    for (n = 0; n < 128u; n++)
+        seq_midi_off(t, n);
+}
+
+static void seq_note_on(track_t *t, uint32_t note, uint32_t vel)       // JSM
+{
+    seq_midi_on(t, note, vel);
+    trk_note_on(t, note, vel);
+}
+
+static void seq_note_off(track_t *t, uint32_t note)                    // JSM
+{
+    seq_midi_off(t, note);
+    trk_note_off(t, note);
+}
+
+#endif /* JSM_BACK_TO_NORMAL */
