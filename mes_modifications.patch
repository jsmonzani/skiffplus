+    [DICE_MINIMAL] = {"a...x...a...x...", "", "....g.......g...", "g.x...xgg.x...x.",
+                      "..x...x...x...x.", "", "...x..g...x..x..", "......g........."},
+    [DICE_DEEP]    = {"a...x...a...x...", "", "............g...", "..x...x...x...x.",
+                      "..g...x...g...x.", "", ".g.....x.g....x.", ""},
+    [DICE_BROKEN]  = {"x..x....x.x.....", "....a..g.g..a...", "",
+                      "x.xgx.x.x.xgx.x.", ".......x........", "", "", ""},
+    [DICE_SPARSE]  = {"x...............", "", "", "", "", "", "......g.....x...", "..........g....."},
+    [DICE_FUNK]    = {"a..x..x.a.x.....", "...g.x..g...x..g", "", "x.x.x.x.x.x.x.x.",
+                      "..............x.", "", "..x.....x.......", ""},
+};
