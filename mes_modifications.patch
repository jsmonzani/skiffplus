+    uint8_t drums, drum_pct, kit[2];
+    uint8_t bass, pads, voicing, lead, arp;
+    uint8_t energy_lo, energy_hi;
+    uint8_t prio[5];
+    uint8_t odd, bars;
+} dice_style_t;
+
+#define DICE_PRIO_DANCE {DICE_BASS, DICE_PAD, DICE_LEAD, DICE_ARP, DICE_TEX}
