+static void mw_block(void)                                             // JSM
+{
+    uint32_t i, dt = fm1_ms - mw_ms, d;
+    mw_ms = fm1_ms;
+    if (dt > 500u)
+        dt = 500u;
+    d = dt * (127u << 8) / 500u;
+    for (i = 0; i < NTRK; i++) {
+        track_t *t = &trk[i];
+        uint32_t b = 1u << i, p, to = (uint32_t)clamp(t->p[P_ED_FX], 0, 127);
